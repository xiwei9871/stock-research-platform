{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_project_index_v2.schema.json",
  "type": "object",
  "required": ["artifact_version", "generated_at", "projects"],
  "properties": {
    "artifact_version": {
      "$ref": "definitions_v2.schema.json#/$defs/semantic_version"
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project_id",
          "project_slug",
          "title",
          "current_lifecycle_state",
          "current_version",
          "latest_reviewed_version",
          "latest_published_version",
          "relative_path"
        ],
        "properties": {
          "project_id": {"type": "string"},
          "project_slug": {"type": "string"},
          "title": {"type": "string"},
          "current_lifecycle_state": {
            "$ref": "definitions_v2.schema.json#/$defs/project_lifecycle"
          },
          "current_version": {"type": "string"},
          "latest_reviewed_version": {"type": ["string", "null"]},
          "latest_published_version": {"type": ["string", "null"]},
          "relative_path": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
