  "theme": {"theme_id":"nuclear_power_equipment_value_chain_v1","theme_name":"核电设备：核岛、常规岛、核级控制与项目生命周期","theme_type":"other","summary":"聚焦商业裂变核电设备，沿核岛主设备、核级泵阀管材、常规岛、核级电机与项目订单交付收入验证研究；所有聚变内容严格留在受控核聚变链。","status":"reviewed","created_from":"mixed","last_updated":"2026-07-18"},
