  "research_profile": {
    "catalog_chain_id": "optical_communications_data_center_interconnect",
    "research_kind": "industry_chain_deep_research",
    "industry_stage": "高速可插拔规模放量与集成光学路线并行验证",
    "central_conflict": "AI集群带宽需求快速上升，但模块功耗、200G及以上光电芯片供给、先进封装与耦合良率、DSP电接口能力、系统互操作和客户认证共同决定产品能否从样品转化为稳定规模交付。",
    "investment_summary": "价值不能只按光模块名义速率判断。研究需同时核验上游光芯片与无源器件供给、硅光与EML路线、可插拔和CPO/NPO形态、相干DCI、DSP/SerDes、电热协同、制造良率及客户认证；只有产品关系、分产品收入或明确量产交付得到年报支持的公司才进入受益者映射。",
    "value_flow_summary": "激光器/探测器及集成光子芯片 -> 精密无源器件与光纤阵列 -> 光引擎和光次模块 -> 高速可插拔/相干DCI模块 -> 交换与传输系统 -> 客户认证、规模制造与交付；硅光、CPO/NPO和DSP/SerDes横向重构多个环节。",
    "profit_pool_summary": "利润池更可能沉淀在高端光芯片、精密耦合与封装、规模良率、低功耗高速模块、相干光学以及拥有头部客户认证和全球交付能力的环节；单纯展示样品或使用宽泛算力概念不足以证明价值捕获。",
    "catalyst_claim_ids": ["optical_claim_11_catalyst"],
    "risk_claim_ids": ["optical_claim_12_risk"],
    "validation_signals": [
      "800G、1.6T及更高速率产品的分产品收入、销量和毛利率",
      "200G及以上EML、CW光源、DSP、Driver和TIA的供应稳定性",
      "硅光、LPO/LRO、CPO/NPO产品的客户验证与规模交付",
      "相干DCI模块及配套WSS、放大器和滤波器的量产进度",
      "耦合封装、测试自动化、可靠性验证与批量良率",
      "客户认证周期、海外产能爬坡和供应链集中度"
    ],
    "evidence_gap_summary": "年报能够确认产品、技术路线和部分分产品收入，但多数公司未披露单型号客户、200G光电芯片采购份额、CPO/NPO良率、DSP供应商、认证通过率及单客户利润贡献，后续需以供应链和客户侧证据补齐。"
  },
