    {"claim_id":"optical_claim_06_silicon_photonics","theme_id":"optical_communications_data_center_interconnect_value_chain_v1","source_id":"optical_000988_2025_report","claim_text":"硅光通过提高集成度并降低高速互联的功耗和尺寸获得增量价值，但仍依赖外置CW光源、耦合封装和规模良率，不能把硅光设计能力等同于完整量产能力。","claim_type":"tech_route","confidence":0.91,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["optical_300308_2025_report","optical_688498_2025_report","optical_688313_2025_report"],"affected_theme_nodes":["silicon_photonics","active_optical_chips","passive_precision_optics"]},
    {"claim_id":"optical_claim_07_cpo_npo","theme_id":"optical_communications_data_center_interconnect_value_chain_v1","source_id":"optical_300502_2025_report","claim_text":"CPO/NPO把光引擎移近交换ASIC以降低电损耗和功耗，但标准、可维护性、封装测试、外置激光源和客户系统验证尚决定商业化节奏，现阶段应区分产品布局、送样和规模收入。","claim_type":"tech_route","confidence":0.87,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["optical_300308_2025_report","optical_000988_2025_report","optical_688313_2025_report"],"affected_theme_nodes":["cpo_npo_optical_io","optical_engines_subassemblies","qualification_yield_delivery"]},
