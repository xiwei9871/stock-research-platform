    {"claim_id":"optical_claim_10_yield_validation","theme_id":"optical_communications_data_center_interconnect_value_chain_v1","source_id":"optical_300308_2025_report","claim_text":"高速光模块从研发到收入必须经过供应商准入、产品代码认证、可靠性测试、工艺认证和批量良率爬坡，交付能力本身构成价值捕获壁垒。","claim_type":"company_mapping","confidence":0.93,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["optical_300394_2025_report","optical_603083_2025_report","optical_301205_2025_report"],"affected_theme_nodes":["qualification_yield_delivery","pluggable_high_speed_modules"]},
