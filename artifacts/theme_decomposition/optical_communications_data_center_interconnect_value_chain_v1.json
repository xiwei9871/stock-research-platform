  "claims": [
    {"claim_id":"optical_claim_01_active_chips","theme_id":"optical_communications_data_center_interconnect_value_chain_v1","source_id":"optical_688498_2025_report","claim_text":"高速光互联的有源光芯片价值来自高功率、低功耗、宽温和可靠性协同；源杰科技数据中心CW光源收入占比超过50%，而中际旭创披露200G及以上EML仍以进口供应为主，说明高端光芯片的量产供给仍是关键瓶颈。","claim_type":"bottleneck","confidence":0.94,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["optical_300308_2025_report"],"affected_theme_nodes":["active_optical_chips"]},
    {"claim_id":"optical_claim_02_passive_precision","theme_id":"optical_communications_data_center_interconnect_value_chain_v1","source_id":"optical_300394_2025_report","claim_text":"FAU、AWG、精密微光学和高密度连接器的价值不在低端零件数量，而在亚微米耦合、工艺稳定性、可靠性和批量良率；天孚、仕佳和长芯博创均披露相关平台或量产产品。","claim_type":"value_capture","confidence":0.9,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["optical_688313_2025_report","optical_300548_2025_report"],"affected_theme_nodes":["passive_precision_optics"]},
    {"claim_id":"optical_claim_03_optical_engines","theme_id":"optical_communications_data_center_interconnect_value_chain_v1","source_id":"optical_300394_2025_report","claim_text":"高速光引擎把芯片封装、精密光学、机械结构和光波导集成为可复用平台，是模块速率提升与CPO/NPO集成之间的重要价值承接层。","claim_type":"value_capture","confidence":0.88,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["optical_000988_2025_report"],"affected_theme_nodes":["optical_engines_subassemblies"]},
    {"claim_id":"optical_claim_04_pluggable_generations","theme_id":"optical_communications_data_center_interconnect_value_chain_v1","source_id":"optical_300308_2025_report","claim_text":"800G已进入规模交付、1.6T开始放量并向单波200G及更高速率演进，但不同厂商的量产、收入和认证阶段差异显著，必须按产品代际而非光模块概念统一判断。","claim_type":"demand_shock","confidence":0.95,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["optical_300502_2025_report","optical_603083_2025_report","optical_301205_2025_report"],"affected_theme_nodes":["pluggable_high_speed_modules"]},
