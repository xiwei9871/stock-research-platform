  },
  "research_profile": {
    "research_kind": "industry_chain_deep_research",
    "catalog_chain_id": "analog_mixed_signal_rf_chips",
    "investment_summary": "可读价值集中于已有自有芯片产品、客户认证、量产和分产品收入的信号链、接口、电源管理与射频芯片公司；研发热度不能替代商业证据。",
    "industry_stage": "国产模拟与射频芯片已从单点产品进入产品族扩张和客户导入阶段，成熟品类已有量产收入，时钟与车规级独立证据仍不足。",
    "central_conflict": "产品型号和下游应用丰富，但多数公司收入按宽产品族或公司总口径披露，节点收入、design win转量产、毛利和库存质量仍需拆分。",
    "value_flow_summary": "价值从芯片设计、流片、封测进入送样、认证和design win，再经量产、订单、交付与确认收入兑现；晶圆代工只作供应依赖。",
    "profit_pool_summary": "利润池偏向高性能信号链、数据转换、隔离接口、射频前端和高可靠收发芯片，前提是产品族收入、客户认证和量产证据闭环。",
    "catalyst_claim_ids": [
      "f4_claim_06",
      "f4_claim_07",
