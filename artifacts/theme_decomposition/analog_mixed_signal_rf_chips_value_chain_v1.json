    "validation_signals": [
      "节点分产品收入与毛利率",
      "客户认证与design win转量产",
      "量产型号和重点客户放量",
      "库存周转与应收回款"
    ],
    "evidence_gap_summary": "时钟/定时和车规工业级独立节点缺少本批直接公司映射；其他节点普遍缺少更细分收入、毛利率、客户集中度和design win转化率。",
    "boundary_rules": [
      "MEMS传感器器件保持G1链所有权",
      "IGBT、MOSFET与分立功率开关器件保持功率半导体链所有权",
      "基站系统、天线和移动网络部署保持F3链所有权",
      "无自有芯片产品证据的封装模组不得映射",
      "晶圆代工产能保持晶圆制造链所有权",
      "通用光通信芯片保持光通信链所有权",
      "卫星通信系统保持卫星通信链所有权"
    ]
  },
