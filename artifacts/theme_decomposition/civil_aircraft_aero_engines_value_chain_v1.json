  "research_profile": {
    "research_kind": "industry_chain_deep_research",
    "catalog_chain_id": "civil_aircraft_aero_engines",
    "investment_summary": "国产大飞机增产与全球民机供应链修复正在把需求传导至机体结构、商用发动机配套、热端锻铸与复合材料。当前可核验价值主要来自已进入供应体系、明确民机工作包、批量交付和可分拆商用航空收入的公司；供应商资格、研制参与和适航试验本身不能替代订单与收入。",
    "industry_stage": "C909/C919机体部件进入批量交付与产能爬坡；国产商用发动机仍处配套试制、适航验证和产业化准备阶段；国际商用发动机零部件已形成长期协议和批量交付。",
    "central_conflict": "民机需求和国产化空间明确，但上市公司披露常把军用、民用、燃机、航天和低空业务混在一起，专项订单、装机量、适航状态、民机收入和MRO存量价值披露不足。",
    "value_flow_summary": "价值由民机平台产量和发动机装机需求向机体结构、复材、发动机整机、热端部件与控制燃油系统传导，经过供应商资格、适航、批产、订单和交付，最终由确认收入、装机保有量、备件/MRO服务兑现。",
    "profit_pool_summary": "近期利润池集中在已有民机工作包和商用发动机长期协议的结构件、锻铸件及国际转包；国产商发整机与控制系统仍需等适航、批产和专项收入；存量MRO潜力较大但上市公司直接披露不足。",
    "catalyst_claim_ids": ["g3_claim_02","g3_claim_07","g3_claim_09","g3_claim_10","g3_claim_14","g3_claim_17"],
    "risk_claim_ids": ["g3_claim_04","g3_claim_06","g3_claim_12","g3_claim_13","g3_claim_15","g3_claim_18"],
    "validation_signals": ["C919/C909部件交付架份与产能爬坡","国产商用发动机适航取证和批产批准","商发供应商资格转长期协议与批量订单","民机或商发专项确认收入与毛利","装机保有量、备件与MRO收入"],
    "evidence_gap_summary": "供应商资格不等于适航认证，适航认证不等于批量生产，批量生产不等于交付或确认收入。C919/ARJ21/国产发动机项目参与、供应商认证、量产交付均需上市公司官方直证。公司总营收与军品收入不得冒充民机节点收入。军用-only aircraft不得映射；商业航天保持商业航天链所有权；低空、eVTOL、UAV保持低空链所有权；泛先进材料不得映射。当前民机总装、机载系统、起落架系统级、专项适航量产和MRO存量服务仍缺上市公司级完整闭环。"
  },
