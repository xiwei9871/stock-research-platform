  "theme": {
    "theme_id": "intelligent_driving_smart_cockpit_value_chain_v1",
    "theme_name": "智能驾驶与智能座舱价值链",
    "theme_type": "other",
    "summary": "覆盖车端感知、数据闭环、定位地图、智驾计算与软件、座舱域控与人机交互、舱驾融合、量产验证及生命周期服务；跨链传感器、芯片和线控执行仅表达应用依赖。",
    "status": "reviewed",
    "created_from": "mixed",
    "last_updated": "2026-07-15"
  },
  "research_profile": {
    "catalog_chain_id": "intelligent_driving_smart_cockpit",
    "research_kind": "industry_chain_deep_research",
    "industry_stage": "L2/L2+辅助驾驶与智能座舱已规模量产，域控制、数据闭环、操作系统和多模态交互持续升级；高阶自动驾驶、舱驾融合与后装运营仍需按车型、法规、交付和收入逐项验证。",
    "central_conflict": "技术展示、项目定点和量产功能不能直接外推为高阶自动驾驶收入或成熟利润；宽汽车电子、智能汽车和AI解决方案收入也不能替代单一节点收入。",
    "investment_summary": "优先验证已量产的感知硬件、域控制器、座舱平台、DMS/OMS、HUD与汽车软件收入，并将地图、算法、舱驾融合、激光雷达、线控执行和生命周期服务的未拆收入保留为缺口。",
    "value_flow_summary": "价值流由摄像头、毫米波雷达等车端感知进入算法与数据闭环，经定位地图、智驾计算、规划决策和车辆控制接口形成辅助驾驶功能；座舱侧由计算平台、域控、OS/中间件进入显示、HUD、声学和人机交互，再在DMS/OMS与舱驾融合层汇合，最终经过量产验证、功能安全、数据合规和生命周期运营兑现。",
    "profit_pool_summary": "可验证利润池集中在规模量产的域控制器、汽车软件IP与开发服务、DMS/OMS算法授权、HUD/显示系统和具备车规交付能力的感知系统；项目制集成、宽口径硬件、验证期融合方案与未拆地图算法收入不构成稳定利润池证据。",
