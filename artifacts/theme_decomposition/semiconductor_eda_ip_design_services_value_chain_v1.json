  "theme": {
    "theme_id": "semiconductor_eda_ip_design_services_value_chain_v1",
    "theme_name": "半导体 EDA、IP 与设计服务：工具链、授权模式与收入验证",
    "theme_type": "other",
    "summary": "从芯片设计工具、半导体 IP、设计服务和晶圆厂设计使能四条价值流出发，区分技术能力、客户采用与可确认收入，识别真正可验证的受益公司。",
    "status": "reviewed",
    "created_from": "mixed",
    "last_updated": "2026-07-16"
  },
  "research_profile": {
    "catalog_chain_id": "semiconductor_eda_ip_design_services",
    "research_kind": "industry_chain_deep_research",
    "industry_stage": "国产工具从点工具突破走向全流程协同，IP 与设计服务已商业化，但收入模式、客户验证和规模化程度分化明显",
    "central_conflict": "国产替代需求明确，但工具覆盖、工艺适配和一次流片成功并不等于稳定收入；真正的价值捕获取决于授权续费、版税放量、设计项目验收和量产导入。",
    "investment_summary": "先看收入来自什么，再看技术覆盖。华大九天、概伦电子代表对外 EDA 授权，芯原股份代表 IP 许可与版税平台，灿芯股份和创耀科技代表设计服务；国芯科技、龙芯中科的 IP 业务直接但收入披露较弱，安路科技和北京君正的工具或 CPU IP 主要服务自有芯片，应作为边界对照而非通用 EDA/IP 受益者。",
    "value_flow_summary": "芯片定义与前端设计验证 -> 后端物理实现与签核 -> 模拟/RF/存储器设计 -> IP 选型和工艺移植 -> 先进封装与 Chiplet 协同 -> 设计服务、验证与流片 -> 晶圆厂 PDK/Design Enablement -> 授权、订阅、许可费和版税 -> 客户采用、项目验收和量产收入。",
    "profit_pool_summary": "利润池优先落在高复用软件/IP、深工艺适配和高迁移成本环节；EDA 的期限授权与续费、IP 的许可费和按量版税、设计服务的项目验收及后续量产管理需要分别核算。自用 EDA、自研 CPU 核和宽口径芯片收入不能替代对外商业化证据。",
    "catalyst_claim_ids": ["eda_ip_claim_10"],
    "risk_claim_ids": ["eda_ip_claim_11", "eda_ip_claim_12"],
    "validation_signals": [
      "EDA 期限授权续费、永久授权新增客户与制造类/设计类工具收入拆分",
      "IP 许可费与按客户芯片销量结算的版税分别增长",
      "设计项目完成验证、流片并转入量产，而非仅签约或研发立项",
      "PDK、工艺平台和客户验证覆盖扩大，并形成可重复收入",
      "自研工具或自研 IP 是否存在对外销售、许可和独立收入披露"
    ],
    "evidence_gap_summary": "多数公司未披露单工具、单 IP、单工艺节点收入和客户留存率；部分年报把项目开发、量产服务或芯片产品混入宽口径收入，因此需要持续核对合同、验收、续费、版税和量产数据。"
  },
