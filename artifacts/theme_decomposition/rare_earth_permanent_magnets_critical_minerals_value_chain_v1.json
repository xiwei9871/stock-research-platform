    ],
    "validation_signals": [
      "生产总量控制计划与实际产量",
      "节点产品实现价格与毛利率",
      "客户认证转订单和收入",
      "产销量、库存与现金周转"
    ],
    "evidence_gap_summary": "选矿精矿、稀土金属合金、SmCo、独立磁体加工和二次资源缺本批直接公司映射；资源公司仍缺节点收入、实现价格和成本，磁材公司需持续核验客户订单与价格传导。",
    "boundary_rules": [
      "下游电机、机器人、风电、EV和消费电子需求不得直接映射为F5公司",
      "泛下游需求不得证明公司受益",
