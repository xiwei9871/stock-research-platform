    "theme_name": "稀土、永磁与关键矿产：资源控制、磁材利润与价格传导",
    "theme_type": "other",
    "summary": "从稀土矿权、分离氧化物、金属磁材、回收供应与市场收入验证研究稀土永磁价值链。",
    "status": "reviewed",
    "created_from": "mixed",
    "last_updated": "2026-07-18"
  },
  "research_profile": {
    "research_kind": "industry_chain_deep_research",
    "catalog_chain_id": "rare_earth_permanent_magnets_critical_minerals",
    "investment_summary": "直接可读价值来自受配额约束的资源与分离能力、可量化的稀土氧化物收入，以及有产品收入、毛利、产销库存和客户认证的钕铁硼公司。",
    "industry_stage": "稀土上游受资源和总量控制约束，中游分离与钕铁硼已规模商业化；钐钴、独立加工和二次资源在本批仍缺公司级直接证据。",
    "central_conflict": "稀土价格上行不自动转化为磁材加工利润；混合口径总收入、下游景气和客户认证均不能替代节点订单、实现价格、收入与毛利。",
    "value_flow_summary": "价值从采矿权、采选精矿、冶炼分离、氧化物与金属进入钕铁硼配方、烧结和交付，再由配额、实现价格、客户认证、订单、收入、毛利和库存验证。",
    "profit_pool_summary": "利润池在资源约束与高纯分离、具备配方工艺和稳定客户的高性能钕铁硼之间分配，但资源价格弹性与磁材加工毛利必须分别跟踪。",
    "catalyst_claim_ids": [
      "f5_claim_02",
      "f5_claim_05",
      "f5_claim_11",
      "f5_claim_13"
    ],
    "risk_claim_ids": [
