  "research_profile": {
    "catalog_chain_id": "semiconductor_manufacturing_equipment",
    "research_kind": "industry_chain_deep_research",
    "industry_stage": "commercial_scaling",
    "central_conflict": "Fab expansion and localization create demand, but durable value capture depends on process performance, customer qualification, reliability, service capability and repeat orders.",
    "investment_summary": "Read the chain by process ownership and qualification depth. Direct equipment exposure is more valuable when installed-base service, repeat orders and node-level revenue can be verified.",
    "value_flow_summary": "pattern definition -> etch/deposition -> thermal and doping -> clean/wet -> CMP -> inspection/metrology -> wafer automation -> vacuum/gas/fluid -> facilities and abatement",
    "profit_pool_summary": "Process IP, chamber reliability, customer qualification, yield learning, installed-base service and critical subsystems are the main barriers; generic factory exposure is lower quality.",
    "catalyst_claim_ids": [
      "semi_eq_claim_09"
    ],
    "risk_claim_ids": [
      "semi_eq_claim_10"
    ],
    "validation_signals": [
      "customer verification to repeat orders",
      "installed-base and service revenue",
      "node-level revenue and gross margin",
      "fab capex and localization progress"
    ],
    "evidence_gap_summary": "Most filings disclose broad equipment categories. Node-level revenue, gross margin, customer mix, imported critical components and repeat-order evidence remain incomplete."
  },
