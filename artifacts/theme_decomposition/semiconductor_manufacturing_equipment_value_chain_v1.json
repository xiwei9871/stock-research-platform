    "theme_name": "半导体制造设备：工艺环节、瓶颈与国产化",
    "theme_type": "semiconductor_equipment",
    "summary": "A process-by-process deep research map of wafer-fab equipment, support subsystems, qualification barriers and evidence-backed domestic beneficiaries.",
    "status": "reviewed",
    "created_from": "mixed",
    "last_updated": "2026-07-14"
