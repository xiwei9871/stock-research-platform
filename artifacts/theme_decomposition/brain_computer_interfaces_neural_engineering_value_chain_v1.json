  "theme": {
    "theme_id": "brain_computer_interfaces_neural_engineering_value_chain_v1",
    "theme_name": "脑机接口与神经工程：路线、临床门槛与收入兑现",
    "theme_type": "other",
    "summary": "研究神经界面、采集芯片、解码软件、神经刺激、植入与非侵入系统如何跨越临床注册并形成真实交付和收入，剔除政策、投资、联盟、实验室与通用医疗器械概念填充。",
    "status": "reviewed",
    "created_from": "mixed",
    "last_updated": "2026-07-17"
  },
  "research_profile": {
    "catalog_chain_id": "brain_computer_interfaces_neural_engineering",
    "research_kind": "industry_chain_deep_research",
    "industry_stage": "非侵入式康复与神经调控已有注册或上市产品，介入式路线出现人体试验，A股上游电极、专用芯片和解码平台仍以样机、研发或混合设备能力为主；独立BCI收入尚未形成材料性披露。",
    "central_conflict": "技术里程碑与商业兑现之间存在长链条断层：政策、研究、原型、人体试验、注册、交付、验收、收入和续约不能相互替代；通用康复、脑电、刺激、传感、手术和医疗器械收入也不能下沉为BCI收入。",
    "investment_summary": "现有八家reviewed映射均为弹性或间接受益，没有可证明独立BCI收入材料性的核心受益公司。伟思、麦澜德、翔宇、爱朋和创新医疗的非侵入式或神经调控产品更接近产品化；诚益通处前期投入，三博提供人体临床验证，康泰仅提供窄口径脑电采集角色。",
    "value_flow_summary": "侵入/介入/非侵入路线 -> 电极与生物界面 -> 低噪声采集与处理 -> 神经解码/编码 -> 刺激或外部设备闭环 -> 植入或非侵入整机 -> 手术、临床与注册 -> 康复/工业/消费交付 -> 收入、复购与经常性服务。",
    "profit_pool_summary": "长期利润池可能位于稳定神经界面、低功耗多通道采集、在线解码与自适应闭环、注册整机及基于疗效和存量装机的服务；当前A股可验证收入仍集中在混合磁刺激、康复、监护和其他医疗器械口径。",
    "catalyst_claim_ids": [
      "bci_claim_01",
      "bci_claim_06",
      "bci_claim_08",
      "bci_claim_09"
    ],
    "risk_claim_ids": [
      "bci_claim_13",
      "bci_claim_14",
      "bci_claim_15"
    ],
    "validation_signals": [
      "侵入式、介入式和非侵入式路线分别跟踪长期安全、信号稳定性与使用时长",
      "电极阻抗漂移、组织反应、通道数、封装寿命与专用芯片功耗",
      "在线解码准确率、延迟、跨日稳定性和校准时长",
      "伦理、临床登记、样本量、随访、不良事件、注册证和医院准入",
      "交付套数、活跃患者、疗效增益、BCI独立收入、复购续约和经常性服务",
      "通用康复、通用脑电、通用刺激、传感器、手术和高端医疗设备继续保留原canonical ownership"
    ],
    "evidence_gap_summary": "11份已接受的一手来源支持15条结构化判断和8家reviewed映射。缺口集中在A股神经电极和专用芯片量产、算法在线性能、植入整机注册、多中心临床、独立BCI收入、交付使用与续约。"
  },
