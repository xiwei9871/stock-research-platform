    {"claim_id":"satellite_claim_06","theme_id":"satellite_manufacturing_space_infrastructure_value_chain_v1","source_id":"sat_688311_filing","claim_text":"卫星专用测控站、信关站、地基基站、相控阵天线、测试终端和用户终端连接星地链路；普通4G/5G专网、北斗行业应用和地面通用网络设备仍留在原链。","claim_type":"value_capture","confidence":0.96,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["sat_600118_filing","sat_300762_filing","sat_002465_filing"],"affected_theme_nodes":["satellite_ground_station_gateway_terminals"]},
