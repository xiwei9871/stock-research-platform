  "claims":[
    {"claim_id":"satellite_claim_01","theme_id":"satellite_manufacturing_space_infrastructure_value_chain_v1","source_id":"sat_600118_filing","claim_text":"卫星平台总体把结构、测控、数据处理、电源、热控、姿轨控、推进和载荷接口集成为可交付航天器；中国卫星具备小微卫星平台谱系、星座设计和AIT一体化能力。","claim_type":"value_capture","confidence":0.98,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":[],"affected_theme_nodes":["satellite_platform_bus_final_assembly"]},
    {"claim_id":"satellite_claim_02","theme_id":"satellite_manufacturing_space_infrastructure_value_chain_v1","source_id":"sat_600118_filing","claim_text":"通信、导航和遥感有效载荷由天线、转发、相控阵、星载导航、光学或雷达仪器及处理电子组成；硬件制造属于本链，下游数据应用与软件服务不归本节点。","claim_type":"tech_route","confidence":0.97,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["sat_600879_filing","sat_001270_filing","sat_300762_filing"],"affected_theme_nodes":["communication_navigation_remote_sensing_payloads"]},
    {"claim_id":"satellite_claim_03","theme_id":"satellite_manufacturing_space_infrastructure_value_chain_v1","source_id":"sat_600879_filing","claim_text":"星上导航、测控通信与网络、数据处理、传感和有效载荷电子需通过型号质量体系、总体联调和客户验收；发射保障或交付总体仍不等于已确认收入。","claim_type":"bottleneck","confidence":0.97,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":[],"affected_theme_nodes":["onboard_avionics_tt_c_data_handling"]},
