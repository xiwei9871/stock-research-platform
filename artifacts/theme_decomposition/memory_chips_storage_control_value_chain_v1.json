  "research_profile": {
    "catalog_chain_id": "memory_chips_storage_control",
    "research_kind": "industry_chain_deep_research",
    "industry_stage": "NOR、SLC NAND、利基DRAM、模组与SSD已规模商业化，国产控制器和企业级产品加速导入，但价格周期、晶圆采购和库存占用仍主导业绩波动",
    "central_conflict": "AI与数据中心推升高性能存储需求，但A股公司多数收入仍来自通用或专用存储、模组和SSD；HBM行业热度不能替代自产颗粒、直接客户、认证或收入证据。",
    "investment_summary": "按收入层级阅读：兆易创新、北京君正、东芯股份、普冉股份是存储器件；澜起科技是内存接口生态；江波龙、佰维存储、德明利是主控/固件、模组与SSD集成；国科微是小体量国产存储控制器；同有科技是企业存储系统。所有HBM判断均保持证据缺口，未将行业背景、3D DRAM、CXL、先进封装或服务器客户自动转为HBM受益。",
    "value_flow_summary": "DRAM/NAND晶圆与专用存储 -> HBM/先进存储路线 -> 主控芯片、ECC和固件 -> eMMC/UFS/内存条/SSD集成 -> 企业级SSD与全闪/分布式存储 -> CPU/OEM/服务器/行业客户认证 -> 晶圆价格、库存和产品结构 -> 出货、验收与可确认收入。",
    "profit_pool_summary": "存储晶圆受价格周期和资本强度影响，专用存储靠长生命周期与认证获取溢价，控制器/固件靠算法和平台复用，模组/SSD靠供应链、产品定义和客户导入，企业存储系统靠数据服务、可靠性与项目交付。必须把晶圆涨价带来的收入增长与销量、产品结构和真实毛利改善分开。",
    "catalyst_claim_ids": ["memory_claim_11"],
    "risk_claim_ids": ["memory_claim_07", "memory_claim_12"],
    "validation_signals": [
      "NOR、NAND、DRAM、控制器、模组、SSD和存储系统收入分别披露",
      "自研控制器或固件完成客户认证并形成独立或可解释收入",
      "企业级SSD、UFS/eMMC、RDIMM/MRDIMM和全闪系统从送样转为批量出货",
      "存货、晶圆价格、经营现金流和毛利率同步改善",
      "HBM必须有自产产品、直接客户认证或明确收入证据"
    ],
    "evidence_gap_summary": "多数公司不拆分单颗存储器、控制器、企业级SSD或固件收入；行业报告常把HBM、CXL和AI服务器并列，但上市公司年报缺少自产HBM颗粒和客户收入证据。"
  },
