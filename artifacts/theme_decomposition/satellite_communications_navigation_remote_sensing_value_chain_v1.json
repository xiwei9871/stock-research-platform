  "theme": {
    "theme_id": "satellite_communications_navigation_remote_sensing_value_chain_v1",
    "theme_name": "卫星通信、导航与遥感应用：容量接入、场景运营与经常性收入",
    "theme_type": "other",
    "summary": "从已投运在轨容量和地面接入出发，追踪卫星通信交付、北斗PNT增强、遥感数据处理、行业应用运营、利用率定价及经常性服务收入，不重复卫星平台、载荷硬件、组批制造和在轨基础设施所有权。",
    "status": "reviewed",
    "created_from": "mixed",
    "last_updated": "2026-07-17"
  },
  "research_profile": {
    "catalog_chain_id": "satellite_communications_navigation_remote_sensing",
    "research_kind": "industry_chain_deep_research",
    "industry_stage": "卫星通信已形成在轨容量、基础电信牌照和行业服务收入，北斗高精度定位、云增强和行业终端进入规模应用，遥感软件、数据处理与监测服务已形成收入；但多数公司仍把硬件、软件、数据、系统集成和运营服务合并披露。",
    "central_conflict": "星座建成、卫星发射、平台交付和终端装机只能提供供给条件，应用链真正兑现取决于客户接入、活跃终端、数据调用、容量与平台利用率、服务定价、合同续约、收入确认和现金回收；这些指标与Wave D的卫星制造及在轨基础设施所有权必须分开。",
    "investment_summary": "本链研究的是如何把在轨容量转换为服务利用与经常性收入：中国卫通以卫星运营、网络系统和综合信息服务形成可核验核心收入；华测导航、北斗星通以高精度PNT增强、位置云服务和行业解决方案形成直接应用关系；中科星图、航天宏图以遥感数据、数字地球、PIE平台和行业应用承接数据价值。振芯科技、司南导航、合众思壮具备北斗行业应用集成，但硬件、系统集成与服务收入未充分拆分，列弹性受益。四维图新的通用地图或智云收入、海格通信的终端、信关站研发或试运行均不足以形成E1 reviewed映射；中国卫星仅作制造边界。",
    "value_flow_summary": "已投运在轨容量 -> 卫星专用地面接入与终端激活 -> 通信、PNT增强和遥感数据服务交付 -> 行业软件、云平台与场景集成 -> 活跃客户、调用量和容量/平台利用率 -> 订阅、按量或项目定价 -> 验收、续约、经常性服务收入与现金回收。",
    "profit_pool_summary": "利润池优先位于稀缺频轨和覆盖资源转化的通信服务、可复用的PNT增强网络与位置云、遥感数据处理和行业平台、长期运维订阅及高续约客户。硬件一次性交付、宽口径项目收入和未拆分的芯片终端销售不自动等于高质量应用服务利润。",
    "catalyst_claim_ids": [
      "satellite_app_claim_12",
      "satellite_app_claim_13"
    ],
    "risk_claim_ids": [
      "satellite_app_claim_11",
      "satellite_app_claim_14",
      "satellite_app_claim_15"
    ],
    "validation_signals": [
      "已投运容量、覆盖区域、可用率和可售服务能力，而非规划或成功发射颗数",
      "已激活终端、连接点、数据调用量、带宽或平台利用率和SLA",
      "卫星通信、PNT增强、遥感数据与行业平台的独立收入、毛利和定价方式",
      "项目初验、服务期间履约、合同续约、应收账款回收和经营现金流",
      "制造、载荷、星上系统、组批AIT、发射和在轨验收继续归satellite_manufacturing_space_infrastructure或commercial_space_launch",
      "概念合作、研制资格、样机、终端定点和宽口径收入不得替代应用服务材料性"
    ],
    "evidence_gap_summary": "10份2025年官方年报覆盖8个节点、15条结构化判断和8家reviewed映射。中国卫通披露卫星传输服务总收入但未拆容量利用率与各应用收入；北斗星通将芯片与数据服务合并；司南导航、合众思壮和振芯科技的应用口径仍混合硬件、软件或系统集成。应用运营、利用率、定价以及经常性服务收入两个节点保持draft，后续重点补充活跃终端、订阅/续约、调用量、ARPU、分应用毛利和回款。"
  },
