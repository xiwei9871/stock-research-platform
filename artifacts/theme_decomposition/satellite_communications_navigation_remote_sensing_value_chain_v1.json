  "claims":[
    {"claim_id":"satellite_app_claim_01","theme_id":"satellite_communications_navigation_remote_sensing_value_chain_v1","source_id":"satellite_app_601698_filing","claim_text":"应用价值流不是从卫星制造开始计价，而是从已投运在轨容量、地面接入和终端激活进入通信、PNT增强、遥感数据与行业平台，再以服务利用、定价、验收、续约和经常性收入完成验证。","claim_type":"tech_route","confidence":0.99,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["satellite_app_688568_filing","satellite_app_688066_filing","satellite_app_300627_filing","satellite_app_002151_filing"],"affected_theme_nodes":["satellite_capacity_service_access","satellite_ground_access_terminal_integration","satellite_communications_service_delivery","satellite_navigation_pnt_augmentation_services","remote_sensing_data_processing_distribution","satellite_vertical_application_integration","application_operations_utilization_pricing","recurring_service_revenue_validation"]},
    {"claim_id":"satellite_app_claim_02","theme_id":"satellite_communications_navigation_remote_sensing_value_chain_v1","source_id":"satellite_app_601698_filing","claim_text":"中国卫通把在轨通信卫星、频轨和地面站网资源转化为卫星运营、网络系统集成和综合信息服务，2025年广播电视和卫星传输服务收入26.4478亿元，客户连接点、SLA和行业覆盖决定下游价值。","claim_type":"value_capture","confidence":0.99,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":[],"affected_theme_nodes":["satellite_capacity_service_access","satellite_communications_service_delivery","application_operations_utilization_pricing","recurring_service_revenue_validation"]},
    {"claim_id":"satellite_app_claim_03","theme_id":"satellite_communications_navigation_remote_sensing_value_chain_v1","source_id":"satellite_app_002465_filing","claim_text":"卫星互联网应用交付需把芯片、模组、终端、信关站、空口测试、天地融合网络和系统运营联通；海格通信与上海瀚讯证明接入链正在建设，但硬件中标、研制资格或试运行不能替代付费服务利用。","claim_type":"bottleneck","confidence":0.95,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["satellite_app_300762_filing"],"affected_theme_nodes":["satellite_ground_access_terminal_integration","satellite_communications_service_delivery"]},
    {"claim_id":"satellite_app_claim_04","theme_id":"satellite_communications_navigation_remote_sensing_value_chain_v1","source_id":"satellite_app_300627_filing","claim_text":"PNT应用利润来自RTK、PPP-RTK、星地融合增强、云辅助、短报文和行业解决方案，而不仅是接收芯片或终端；PointX、TruePoint及北斗综合应用已进入测绘、农业、施工、机器人、智能驾驶和海洋等场景。","claim_type":"value_capture","confidence":0.98,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["satellite_app_002151_filing","satellite_app_300101_filing","satellite_app_002405_filing"],"affected_theme_nodes":["satellite_navigation_pnt_augmentation_services","satellite_vertical_application_integration","application_operations_utilization_pricing"]},
    {"claim_id":"satellite_app_claim_05","theme_id":"satellite_communications_navigation_remote_sensing_value_chain_v1","source_id":"satellite_app_688568_filing","claim_text":"遥感应用以卫星数据接收、校正、处理、智能解译、云端分发和行业决策形成价值；中科星图的数字地球与星图云、航天宏图的PIE-Engine和数据分析服务属于下游应用，不归载荷硬件制造节点。","claim_type":"tech_route","confidence":0.99,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["satellite_app_688066_filing"],"affected_theme_nodes":["remote_sensing_data_processing_distribution","satellite_vertical_application_integration"]},
    {"claim_id":"satellite_app_claim_06","theme_id":"satellite_communications_navigation_remote_sensing_value_chain_v1","source_id":"satellite_app_688066_filing","claim_text":"自然资源、农业、应急、交通、城市、能源、海洋和智能设备等垂直场景需要把卫星数据或PNT与软件、云平台、模型、终端和客户工作流集成，复用平台和持续运维比单次数据交付更有经营杠杆。","claim_type":"value_capture","confidence":0.96,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["satellite_app_688568_filing","satellite_app_300627_filing","satellite_app_300101_filing","satellite_app_002405_filing"],"affected_theme_nodes":["satellite_vertical_application_integration","application_operations_utilization_pricing"]},
    {"claim_id":"satellite_app_claim_07","theme_id":"satellite_communications_navigation_remote_sensing_value_chain_v1","source_id":"satellite_app_601698_filing","claim_text":"应用运营必须跟踪连接点、活跃终端、数据调用、容量或平台利用率、服务等级、按量或订阅定价和续约；可售容量、平台上线和终端装机如果缺少真实使用，不能形成稳定利润池。","claim_type":"cost_structure","confidence":0.97,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["satellite_app_002151_filing","satellite_app_688568_filing"],"affected_theme_nodes":["application_operations_utilization_pricing","recurring_service_revenue_validation"]},
    {"claim_id":"satellite_app_claim_08","theme_id":"satellite_communications_navigation_remote_sensing_value_chain_v1","source_id":"satellite_app_002151_filing","claim_text":"上市公司受益验证必须同时具备应用产品或服务关系、窄口径收入材料性和商业阶段证据；项目中标、平台能力、样机、芯片终端宽收入或合作公告不能单独进入默认reviewed受益表。","claim_type":"company_mapping","confidence":0.99,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["satellite_app_601698_filing","satellite_app_688568_filing","satellite_app_688066_filing","satellite_app_300627_filing","satellite_app_300101_filing","satellite_app_002465_filing","satellite_app_002405_filing"],"affected_theme_nodes":["recurring_service_revenue_validation"]},
    {"claim_id":"satellite_app_claim_09","theme_id":"satellite_communications_navigation_remote_sensing_value_chain_v1","source_id":"satellite_app_601698_filing","claim_text":"卫星通信业务准入和大众场景扩展、连接点增长、PNT云增强规模商用、遥感平台云化与行业数据需求，是应用链催化；催化必须最终落到利用率、服务收入、续约和现金回收。","claim_type":"catalyst","confidence":0.93,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["satellite_app_688568_filing","satellite_app_002151_filing","satellite_app_300627_filing"],"affected_theme_nodes":["satellite_capacity_service_access","satellite_communications_service_delivery","satellite_navigation_pnt_augmentation_services","remote_sensing_data_processing_distribution","application_operations_utilization_pricing"]},
    {"claim_id":"satellite_app_claim_10","theme_id":"satellite_communications_navigation_remote_sensing_value_chain_v1","source_id":"satellite_app_601698_filing","claim_text":"星链等竞争、传统广电需求下滑、容量闲置、价格下降、SLA不达标和客户集中会压低通信服务利用率；PNT与遥感平台也可能因同质化和云资源成本导致收入增长而利润不足。","claim_type":"risk","confidence":0.96,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["satellite_app_002151_filing","satellite_app_688568_filing"],"affected_theme_nodes":["application_operations_utilization_pricing","recurring_service_revenue_validation"]},
    {"claim_id":"satellite_app_claim_11","theme_id":"satellite_communications_navigation_remote_sensing_value_chain_v1","source_id":"satellite_app_688066_filing","claim_text":"政府与大型机构项目预算、初验和付款周期会造成应收账款、合同资产和经营现金流压力；收入确认不等于现金回收，服务续约与回款必须独立验证。","claim_type":"risk","confidence":0.98,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["satellite_app_688568_filing","satellite_app_601698_filing"],"affected_theme_nodes":["recurring_service_revenue_validation"]},
    {"claim_id":"satellite_app_claim_12","theme_id":"satellite_communications_navigation_remote_sensing_value_chain_v1","source_id":"satellite_app_600118_filing","claim_text":"卫星平台、通信导航遥感载荷硬件、星上系统、组批制造、AIT、交付发射和在轨基础设施运营继续由satellite_manufacturing_space_infrastructure拥有；E1只拥有容量接入后的服务交付、应用运营、利用率、定价和收入关系。","claim_type":"risk","confidence":0.99,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["satellite_app_300762_filing","satellite_app_002465_filing"],"affected_theme_nodes":["satellite_capacity_service_access","satellite_ground_access_terminal_integration","remote_sensing_data_processing_distribution","satellite_vertical_application_integration"]},
    {"claim_id":"satellite_app_claim_13","theme_id":"satellite_communications_navigation_remote_sensing_value_chain_v1","source_id":"satellite_app_688568_filing","claim_text":"应用侧瓶颈集中在多源数据时效与质量、遥感智能解译、PNT增强覆盖与完好性、跨终端兼容、客户工作流适配、数据合规和云服务成本，而非单纯增加卫星或终端数量。","claim_type":"bottleneck","confidence":0.95,"evidence_status":"verified","platform_use_status":"reviewed","supporting_source_ids":["satellite_app_688066_filing","satellite_app_300627_filing","satellite_app_002151_filing"],"affected_theme_nodes":["satellite_navigation_pnt_augmentation_services","remote_sensing_data_processing_distribution","satellite_vertical_application_integration"]},
