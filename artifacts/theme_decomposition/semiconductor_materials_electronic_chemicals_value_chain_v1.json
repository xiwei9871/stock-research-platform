  "theme": {
    "theme_id": "semiconductor_materials_electronic_chemicals_value_chain_v1",
    "theme_name": "半导体材料与电子化学品：纯度、认证、一致性与国产替代价值链",
    "theme_type": "other",
    "summary": "从硅片与化合物半导体衬底、光刻胶、湿电子化学品、CMP材料、溅射靶材、电子气体和沉积前驱体，延伸至纯化、容器输送、晶圆厂认证与批次一致性，识别材料从样品走向稳定量产的价值瓶颈。",
    "status": "reviewed",
    "created_from": "mixed",
    "last_updated": "2026-07-14"
  },
  "research_profile": {
    "catalog_chain_id": "semiconductor_materials_electronic_chemicals",
    "research_kind": "industry_chain_deep_research",
    "industry_stage": "国产材料由单点验证向多品类稳定批量供应过渡",
    "central_conflict": "晶圆厂扩产与供应链本土化带来需求，但材料的名义纯度和产能不等于可用供给；客户认证、缺陷控制、批次一致性、洁净包装输送和持续交付共同决定收入与利润兑现。",
    "investment_summary": "研究应优先核验分产品收入、产销量、纯度与杂质指标、客户验证阶段、稳定批量供应和产能利用率；只有披露口径与具体材料节点匹配时才赋予材料性，宽口径半导体材料或电子材料收入不得下沉到单一节点。",
    "value_flow_summary": "基础衬底与高纯原料 -> 配方、合成、纯化和精密加工 -> 洁净包装、专用容器与输送 -> 晶圆厂审厂、样品、小批量和批量验证 -> 稳定供货与工艺迭代；良率反馈再反向约束配方和批次控制。",
    "profit_pool_summary": "利润池更可能沉淀在高纯原料自制、复杂配方与精密加工、先进节点适配、长周期客户认证、批次一致性和稳定交付环节；只有名义产能、研发项目或宽泛国产替代表述不足以证明价值捕获。",
    "catalyst_claim_ids": [
      "semimat_claim_11_catalyst"
    ],
    "risk_claim_ids": [
      "semimat_claim_12_risk"
    ],
    "validation_signals": [
      "分产品收入、销量和毛利率是否与具体材料节点匹配",
      "新规格由样品、小批量验证转入稳定批量供应",
      "金属杂质、颗粒、缺陷和批次一致性指标",
      "新产线产能利用率、良率和折旧吸收",
      "核心原料自制与第二供应源验证",
      "洁净容器、现场供气和交付满足率"
    ],
    "evidence_gap_summary": "年报可确认产品、分类收入、产能和部分客户验证，但普遍未披露单一客户、单一先进节点收入、认证通过率、批次报废率、晶圆良率改善、容器周转效率和分产品利润，后续需继续按节点跟踪。"
  },
