  "research_profile": {
    "catalog_chain_id": "humanoid_robots_embodied_intelligence",
    "research_kind": "industry_chain_deep_research",
    "industry_stage": "early_commercialization",
    "central_conflict": "The component opportunity is broad, but most disclosures remain between R&D, samples and early delivery, so product capability must be separated from material humanoid revenue.",
    "investment_summary": "Read beneficiaries by subsystem, commercialization stage and evidence quality. Components with precision, reliability and qualification barriers are more attractive than generic robot mentions.",
    "value_flow_summary": "embodied model and data -> perception -> compute/control -> joints and actuators -> dexterous hand -> sensing -> energy and wiring -> structures -> system integration and deployment",
    "profit_pool_summary": "Precision motion components, feedback sensors, compact motors, controllers, system software and validated integration can hold value; prototype-only and generic industrial-robot exposure are weaker.",
    "catalyst_claim_ids": [
      "robotics_claim_09"
    ],
    "risk_claim_ids": [
      "robotics_claim_10"
    ],
    "validation_signals": [
      "sample to batch-delivery conversion",
      "humanoid-specific customer qualification",
      "component yield and cost reduction",
      "robot utilization and repeat deployment"
    ],
    "evidence_gap_summary": "Humanoid-specific revenue, customer names, allocation, gross margin, order conversion and batch-delivery evidence are still limited across most listed-company filings."
  },
