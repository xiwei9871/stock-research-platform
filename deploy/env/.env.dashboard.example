# Example server-only environment for stock-research-api.service.
# Do not copy secrets into dashboard/dist or any frontend bundle.

DASHBOARD_API_BIND_HOST=127.0.0.1
DASHBOARD_API_BIND_PORT=8765
DASHBOARD_PUBLIC_BASE_URL=https://stock-research.example.com

# Do not bind FastAPI to 0.0.0.0 for normal deployment. If public bind is
# temporarily required for debugging, restrict it with security groups/IP allowlists.

# PostgreSQL service lookup. PostgreSQL should stay on a private socket/network.
PGSERVICEFILE=/etc/postgresql-common/pg_service.conf
PGSERVICE=stock_research
# Database port must not be opened to the public internet.

# Server-only write guard. Rotate before production use.
STOCK_RESEARCH_DASHBOARD_WRITE_GUARD=true
STOCK_RESEARCH_DASHBOARD_WRITE_TOKEN=replace-with-server-only-token

# First-party dashboard auth. These values are server-only runtime config.
STOCK_RESEARCH_DASHBOARD_AUTH_REQUIRED=true
STOCK_RESEARCH_DASHBOARD_COOKIE_SECURE=true

# Kronos runs on the GPU host (187). The dashboard API keeps this token
# server-side and proxies only the authenticated prediction endpoints.
KRONOS_PROXY_BASE_URL=http://192.168.3.187:8080/api/internal
KRONOS_PROXY_TOKEN=replace-with-a-random-server-only-token
KRONOS_PROXY_TIMEOUT_SECONDS=30
STOCK_RESEARCH_DASHBOARD_SESSION_TTL_SECONDS=43200

# Optional runtime tuning.
PYTHONUNBUFFERED=1
